{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "homelab-kvm",
  "version": "0.1.0",
  "identifier": "net.homelab.kvm",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "homelab-kvm", "width": 1200, "height": 760, "minWidth": 720, "minHeight": 480 }
    ],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
